<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
		Parent Maven de TeamSlot (ADR-015, SCRUM-88).
		Versions, correctifs de securite et plugins communs ecrits une seule fois.
		Les services y passent un par un (ordre de l'ADR-015) ; les autres gardent leur build pour l'instant.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>ma.teamslot</groupId>
	<artifactId>teamslot-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>teamslot-parent</name>
	<description>Parent Maven de TeamSlot : versions, correctifs de securite et plugins communs (ADR-015)</description>

	<modules>
		<module>libs/events</module>
		<module>services/service-template</module>
		<module>services/payment-service</module>
		<module>services/match-service</module>
        <module>services/venue-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- Correctifs Trivy (SCRUM-28, PR #27) : versions corrigees de Tomcat et Jackson.
		     A retirer quand Spring Boot embarque une version au moins egale. -->
		<tomcat.version>11.0.25</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- CVE-2026-106451 (HIGH) : lz4-java arrive par kafka-clients ; version corrigee forcee (Trivy, PR #86).
			     A retirer quand Spring Boot embarque lz4-java 1.11.4 ou plus. -->
			<dependency>
				<groupId>at.yawk.lz4</groupId>
				<artifactId>lz4-java</artifactId>
				<version>1.11.4</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Couverture des tests pour SonarCloud, dans tous les modules -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
