{
  "uid": "teamslot-services",
  "title": "TeamSlot - Services (staging)",
  "tags": ["teamslot"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "ds", "label": "Source", "type": "datasource", "query": "prometheus"},
    {"name": "service", "label": "Service", "type": "query",
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "query": {"query": "label_values(http_server_requests_seconds_count{namespace=\"staging\"}, job)", "refId": "svc"},
     "includeAll": true, "multi": true, "allValue": ".*", "refresh": 2,
     "current": {"selected": true, "text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Services vivants (1 = collecte OK)",
     "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "up{namespace=\"staging\", job=~\"$service\"}", "legendFormat": "{{job}}", "datasource": {"type": "prometheus", "uid": "${ds}"}}]},
    {"id": 2, "type": "timeseries", "title": "Débit (req/s, hors actuator)",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\", uri!~\"/actuator.*\"}[5m]))", "legendFormat": "{{job}}", "datasource": {"type": "prometheus", "uid": "${ds}"}}]},
    {"id": 3, "type": "timeseries", "title": "Erreurs 5xx (req/s)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "0"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\", status=~\"5..\"}[5m]))", "legendFormat": "{{job}}", "datasource": {"type": "prometheus", "uid": "${ds}"}}]},
    {"id": 4, "type": "timeseries", "title": "Latence moyenne (s)",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_sum{job=~\"$service\", uri!~\"/actuator.*\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\", uri!~\"/actuator.*\"}[5m]))", "legendFormat": "{{job}}", "datasource": {"type": "prometheus", "uid": "${ds}"}}]},
    {"id": 5, "type": "timeseries", "title": "Latence maximale (s)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
     "datasource": {"type": "prometheus", "uid": "${ds}"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "max by (job) (http_server_requests_seconds_max{job=~\"$service\", uri!~\"/actuator.*\"})", "legendFormat": "{{job}}", "datasource": {"type": "prometheus", "uid": "${ds}"}}]}
  ]
}
