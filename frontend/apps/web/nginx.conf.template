# Modèle nginx : l'image nginx-unprivileged remplace ${API_UPSTREAM} au démarrage (20-envsubst-on-templates.sh)
# et écrit le résultat dans /etc/nginx/conf.d/default.conf.
#   docker-compose : API_UPSTREAM=http://gateway:8080
#   Kubernetes     : API_UPSTREAM=http://gateway (le Service écoute sur le port 80)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # SCRUM-120 : pas de version de nginx dans l'en-tête Server (alerte ZAP Low)
  server_tokens off;

  # SCRUM-114 : en-têtes de sécurité. « always » les envoie aussi sur les erreurs (404, 502...).
  # Attention : un add_header dans un bloc location remplacerait TOUS ceux-ci pour ce bloc (héritage nginx).
  # SCRUM-120 : form-action 'self' (une CSP sans form-action laisse un formulaire poster ailleurs, alerte ZAP Medium).
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  # SCRUM-120 : fonctions du navigateur dont TeamSlot n'a pas besoin, refusées à la page et à tout cadre (alerte ZAP Low)
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()" always;
  # SCRUM-120 : isolation contre Spectre (alerte ZAP Low). Tout est servi par la même origine (front, /api, polices,
  # textures 3D) : aucune ressource d'une autre origine n'est chargée, require-corp ne bloque donc rien.
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Cross-Origin-Embedder-Policy "require-corp" always;
  add_header Cross-Origin-Resource-Policy "same-origin" always;
  add_header Strict-Transport-Security "max-age=86400" always;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Rien de ce qui vient de l'API ne doit être mis en cache par le navigateur sans que le serveur le décide
  }

  location / {
    try_files $uri /index.html;
  }
}
